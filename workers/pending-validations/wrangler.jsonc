{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "astro-notification-pending-validations",
  "main": "../../src/workers/pending-validations.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "triggers": { "crons": ["15 11 * * *"] },
  "vars": { "ENABLED": "false", "DRY_RUN": "true", "WORKSPACE_IDS": "", "VALIDATION_WAIT_HOURS": "48" }
}
