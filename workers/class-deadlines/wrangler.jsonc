{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "astro-notification-class-deadlines",
  "account_id": "25eb8d3849be3adbff3678f4ec781804",
  "main": "../../src/workers/class-deadlines.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
      "head_sampling_rate": 1,
      "persist": false,
      "destinations": [
        "astro-grafana-logs"
      ]
    }
  },
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "c561f75615114c0b9358bc5c35159b7d" }],
  "services": [{ "binding": "NOTIFICATION_CONTROL", "service": "astro-notification-delivery-control", "entrypoint": "DeliveryControl" }],
  "triggers": { "crons": [] },
  "vars": { "APP_ENV": "production", "ENABLED": "true", "DRY_RUN": "false", "CLASS_WARNING_HOURS": "24" }
}
