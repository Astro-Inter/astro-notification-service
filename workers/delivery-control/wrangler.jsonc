{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "astro-notification-delivery-control",
  "account_id": "25eb8d3849be3adbff3678f4ec781804",
  "main": "../../src/workers/delivery-control.ts",
  "compatibility_date": "2026-10-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
      "head_sampling_rate": 1,
      "persist": false,
      "destinations": [
        "astro-grafana-logs"
      ]
    }
  },
  "vars": { "APP_ENV": "production" },
  "durable_objects": { "bindings": [{ "name": "DELIVERIES", "class_name": "NotificationCoordinator" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["NotificationCoordinator"] }]
}
