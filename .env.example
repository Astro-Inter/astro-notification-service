# Configuração local. Use credenciais próprias e nunca versione o arquivo .env.
# PostgreSQL: em produção prefira o binding HYPERDRIVE sem cache de consultas.
DATABASE_URL=postgresql://usuario:senha@localhost:5432/astro?sslmode=disable
# CA do provedor para conexão PostgreSQL direta; PEM com quebras escapadas (\n).
PG_CA_CERT=
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=astro
ENABLED=false
DRY_RUN=true
EXPIRY_WARNING_DAYS=30,7
CLASS_WARNING_HOURS=24
VALIDATION_WAIT_HOURS=48
BATCH_SIZE=100
MAX_BATCHES=100
